{
	"info": {
		"_postman_id": "c1a2b3c4-d5e6-4f7g-8h9i-j0k1l2m3n4o5",
		"name": "CrewAI Celery API",
		"description": "Collection untuk testing API CrewAI dengan Celery asinkron.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Start Research",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData.task_id) {",
							"    pm.collectionVariables.set(\"task_id\", jsonData.task_id);",
							"    console.log(\"task_id saved: \" + jsonData.task_id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"topic\": \"Artificial Intelligence in Manufacturing\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "http://localhost:8000/research",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8000",
					"path": [
						"research"
					]
				},
				"description": "Kirim topik riset ke AI Agents."
			},
			"response": []
		},
		{
			"name": "Start RAG (Upload Txt)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData.task_id) {",
							"    pm.collectionVariables.set(\"task_id\", jsonData.task_id);",
							"    console.log(\"task_id saved: \" + jsonData.task_id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "file",
							"type": "file",
							"src": []
						}
					]
				},
				"url": {
					"raw": "http://localhost:8000/rag",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8000",
					"path": [
						"rag"
					]
				},
				"description": "Upload file .txt untuk dianalisis oleh Crew RAG."
			},
			"response": []
		},
		{
			"name": "Check Status",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8000/status/{{task_id}}",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8000",
					"path": [
						"status",
						"{{task_id}}"
					]
				},
				"description": "Cek status dan hasil dari task_id yang didapatkan secara otomatis."
			},
			"response": []
		}
